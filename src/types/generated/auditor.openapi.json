          }
        },
        "summary": "Cancel Ux Audit"
      }
    },
    "/api/ux/{project}/results": {
      "get": {
        "description": "Return the latest UX audit results (findings + screenshots) from disk.",
        "operationId": "get_ux_results_api_ux__project__results_get",
        "parameters": [
          {
            "in": "path",
            "name": "project",
            "required": true,
            "schema": {
              "title": "Project",
